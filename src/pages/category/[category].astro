---
import Layout from "@layouts/Layout.astro";
import AuthorCard from "@components/AuthorCard.astro";
import TaxonomyCloud from "@components/TaxonomyCloud.astro";
import PostCard from "@components/PostCard.astro";
import { getPublishedPosts } from "@lib/content";
import { SITE_CONFIG } from "@config";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = new Set(posts.map((p) => p.data.category).filter((c): c is string => Boolean(c)));
  return [...categories].map((category) => ({ params: { category }, props: { category } }));
}

const { category } = Astro.props;
const posts = await getPublishedPosts();
const counts = new Map<string, number>();
for (const post of posts) {
  if (!post.data.category) continue;
  counts.set(post.data.category, (counts.get(post.data.category) ?? 0) + 1);
}
const items = [...counts.entries()]
  .map(([name, count]) => ({ name, href: `/category/${name}/`, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "zh-Hans-CN"));
const matched = posts.filter((p) => p.data.category === category);
---

<Layout title={`${category} · 分类 · ${SITE_CONFIG.brandName}`}>
  <div class="mx-auto grid max-w-[1100px] grid-cols-[1fr_300px] items-start gap-10 px-6 py-8 max-md:grid-cols-1 max-md:gap-0 max-md:p-4">
    <section class="min-w-0" aria-label={`分类 ${category}`}>
      <h1 class="mb-6 text-2xl font-bold">分类</h1>
      <TaxonomyCloud items={items} active={category} hint={`${category} 下的 ${matched.length} 篇文章`} />
      <div>{matched.map((post) => <PostCard post={post} />)}</div>
    </section>
    <aside class="sticky top-[88px] self-start max-md:hidden">
      <AuthorCard />
    </aside>
  </div>
</Layout>
