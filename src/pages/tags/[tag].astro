---
import Layout from "@layouts/Layout.astro";
import PostCard from "@components/PostCard.astro";
import { getPublishedPosts } from "@lib/content";
import { getAllTags, getPostsByTag } from "@utils/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return [...getAllTags(posts).keys()].map((tag) => ({
    params: { tag },
    props: { posts: getPostsByTag(posts, tag), tag },
  }));
}

const { posts, tag } = Astro.props;
---

<Layout title={`${tag} · 标签 · Ray Hsu`}>
  <section class="mx-auto w-full max-w-3xl px-6 py-10 max-md:px-4 md:py-14">
    <h1 class="mb-8 text-2xl font-bold tracking-tight text-ink md:text-3xl">
      标签：{tag}
    </h1>
    <div class="flex flex-col gap-5">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</Layout>
