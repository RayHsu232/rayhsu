---
import Layout from "@layouts/Layout.astro";
import { getPublishedPosts } from "@lib/content";
import { render } from "astro:content";
import { formatDate } from "@utils/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} · Ray Hsu`} description={post.data.description}>
  <article class="mx-auto w-full max-w-3xl py-10 md:py-14">
    <header class="mb-10">
      <div class="mb-3 flex items-center gap-3 text-sm text-muted">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        {
          post.data.category && (
            <span class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs text-accent">
              {post.data.category}
            </span>
          )
        }
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">
        {post.data.title}
      </h1>
    </header>

    <div class="prose prose-zinc max-w-none">
      <Content />
    </div>

    <nav
      class="mt-14 grid gap-4 border-t border-line pt-8 sm:grid-cols-2"
      aria-label="相邻文章"
    >
      {
        older ? (
          <a
            href={`/posts/${older.id}/`}
            class="rounded-2xl border border-line bg-surface p-4 text-sm text-muted transition-colors hover:border-accent hover:text-ink"
          >
            ← 较早：{older.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        newer ? (
          <a
            href={`/posts/${newer.id}/`}
            class="rounded-2xl border border-line bg-surface p-4 text-right text-sm text-muted transition-colors hover:border-accent hover:text-ink"
          >
            较新：{newer.data.title} →
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Layout>
