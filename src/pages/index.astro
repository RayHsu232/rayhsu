---
import Layout from "@layouts/Layout.astro";
import PostCard from "@components/PostCard.astro";
import SidebarProfile from "@components/SidebarProfile.astro";
import { getPublishedPosts } from "@lib/content";

const posts = await getPublishedPosts();
---

<Layout>
  <div class="grid gap-10 py-10 md:grid-cols-[1fr_320px] md:py-14">
    <section aria-label="文章列表" class="min-w-0">
      <h1 class="mb-8 text-2xl font-bold tracking-tight text-ink md:text-3xl">
        全部文章
      </h1>
      <div class="flex flex-col gap-5">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      {
        posts.length === 0 && (
          <p class="rounded-2xl border border-line bg-surface p-8 text-center text-muted">
            还没有文章，敬请期待。
          </p>
        )
      }
    </section>
    <aside class="md:sticky md:top-24 md:self-start">
      <SidebarProfile posts={posts} />
    </aside>
  </div>
</Layout>
