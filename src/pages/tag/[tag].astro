---
import Layout from "@layouts/Layout.astro";
import AuthorCard from "@components/AuthorCard.astro";
import TaxonomyCloud from "@components/TaxonomyCloud.astro";
import PostCard from "@components/PostCard.astro";
import { getPublishedPosts } from "@lib/content";
import { getAllTags, getPostsByTag } from "@utils/posts";
import { SITE_CONFIG } from "@config";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return [...getAllTags(posts).keys()].map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = await getPublishedPosts();
const items = [...getAllTags(posts).entries()].map(([name, count]) => ({
  name,
  href: `/tag/${name}/`,
  count,
}));
const matched = getPostsByTag(posts, tag);
---

<Layout title={`${tag} · 标签 · ${SITE_CONFIG.brandName}`}>
  <div class="mx-auto grid max-w-[1100px] grid-cols-[1fr_300px] items-start gap-10 px-6 py-8 max-md:grid-cols-1 max-md:gap-0 max-md:p-4">
    <section class="min-w-0" aria-label={`标签 ${tag}`}>
      <h1 class="mb-6 text-2xl font-bold">标签</h1>
      <TaxonomyCloud items={items} active={tag} hint={`${tag} 下的 ${matched.length} 篇文章`} />
      <div>{matched.map((post) => <PostCard post={post} />)}</div>
    </section>
    <aside class="sticky top-[88px] self-start max-md:hidden">
      <AuthorCard />
    </aside>
  </div>
</Layout>
