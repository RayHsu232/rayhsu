---
import { Icon } from "astro-icon/components";
import { PROFILE } from "@config";
---

<div class="my-8 rounded-xl border border-hairline bg-elevated px-6 py-5">
  <h4 class="mb-1 text-[1rem] font-semibold text-ink">{PROFILE.name}</h4>
  <p class="mb-2 text-[0.8125rem] leading-normal text-subtle">{PROFILE.bio}</p>
  <div class="flex flex-wrap gap-3">
    <a
      href={PROFILE.github}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-[0.8125rem] text-faint transition-colors duration-200 hover:text-brand"
    >
      <Icon name="simple-icons:github" class="size-[22px]" />
      <span>GitHub</span>
    </a>
  </div>
  <div class="mt-3 relative inline-block group">
    <button
      type="button"
      class="inline-flex cursor-pointer items-center gap-1.5 rounded-md border border-hairline px-2.5 py-1 text-[0.8125rem] text-subtle transition-colors duration-200 hover:border-brand hover:text-brand"
    >
      <Icon name="ph:chats-circle" class="size-4" />
      关注公众号：{PROFILE.name}
    </button>
    <div
      class="pointer-events-none absolute bottom-full left-0 z-10 mb-2 hidden rounded-lg border border-line bg-base p-2 shadow-[0_4px_12px_var(--card-shadow)] group-hover:block"
    >
      <img src="/wechat/qrcode-light.png" alt="微信公众号二维码" class="wechat-qr-light block max-h-60 w-auto" loading="lazy" width="452" />
      <img src="/wechat/qrcode-dark.png" alt="微信公众号二维码" class="wechat-qr-dark block max-h-60 w-auto" loading="lazy" width="452" />
    </div>
  </div>
  <p class="mt-3 text-[0.8125rem] text-faint">如果觉得文章不错，欢迎关注和分享 🙏</p>
</div>
