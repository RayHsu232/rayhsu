---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, specialty, summary, email } = Astro.props;
---

<section class="py-20 md:py-24">
  <h1 class="mb-2 text-6xl font-bold tracking-tight text-ink md:text-7xl">
    {name}
  </h1>
  <p class="mb-8 text-2xl font-semibold tracking-tight text-accent md:text-4xl">
    {specialty}
  </p>
  <p class="mb-12 max-w-[65ch] text-base leading-relaxed text-muted md:text-lg">
    {summary}
  </p>

  <a
    class="inline-block rounded-full bg-accent px-8 py-4 text-sm font-medium text-white transition-all duration-300 hover:bg-blue-700 active:scale-[0.98]"
    href={`mailto:${email}`}>联系我</a
  >
</section>
