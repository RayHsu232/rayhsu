---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { description, image, name } = Astro.props;
---

<Section text="关于我" href="about">
  <div class="flex flex-col items-center gap-10 md:flex-row md:gap-8">
    <p class="max-w-[65ch] whitespace-pre-line text-base leading-relaxed text-subtle md:pr-5">
      {description}
    </p>
    <div
      class="h-72 w-60 flex-shrink-0 rotate-[5deg] rounded-lg border border-line bg-base p-3 shadow-sm md:rotate-[7deg]"
    >
      <Image
        class="h-full w-full rounded-md object-cover"
        src={image}
        width="260"
        height="260"
        alt={name}
      />
    </div>
  </div>
</Section>
