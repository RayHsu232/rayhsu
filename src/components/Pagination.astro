---
type Props = { current: number; total: number; prevUrl?: string; nextUrl?: string };

const { current, total, prevUrl, nextUrl } = Astro.props;
const linkBase =
  "rounded-md border border-line px-4 py-2 text-sm transition-colors duration-200 max-md:px-3 max-md:py-1.5 max-md:text-[0.8125rem]";
const linkActive = `${linkBase} text-ink hover:border-brand`;
const linkDisabled = `${linkBase} pointer-events-none text-faint opacity-50`;
---

<nav class="mt-8 flex items-center justify-center gap-4 border-t border-hairline pt-6 max-md:mt-6 max-md:gap-2 max-md:pt-4" aria-label="分页导航">
  {prevUrl ? <a href={prevUrl} class={linkActive}>« 上一页</a> : <span class={linkDisabled}>« 上一页</span>}
  <span class="text-sm text-subtle">{current} / {total}</span>
  {nextUrl ? <a href={nextUrl} class={linkActive}>下一页 »</a> : <span class={linkDisabled}>下一页 »</span>}
</nav>
