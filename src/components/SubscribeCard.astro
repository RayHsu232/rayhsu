<div class="mt-6 rounded-xl border border-hairline bg-elevated p-5">
  <h3 class="mb-1 text-[1rem] font-semibold text-ink">📬 订阅更新</h3>
  <p class="mb-3 text-[0.8rem] text-subtle">新文章发布时邮件通知你，无垃圾邮件。</p>
  <form id="subscribe-form" class="flex gap-2">
    <input
      type="email"
      required
      placeholder="your@email.com"
      class="min-w-0 flex-1 rounded-lg border border-line bg-base px-3 py-2 text-sm text-ink outline-none transition-colors duration-200 placeholder:text-faint focus:border-brand"
    />
    <button
      type="submit"
      class="rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-base transition-opacity duration-200 hover:opacity-90"
    >
      订阅
    </button>
  </form>
  <p id="subscribe-msg" class="mt-2 hidden text-[0.8rem] text-subtle">订阅功能即将上线，敬请期待。</p>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>("#subscribe-form");
  const msg = document.querySelector<HTMLElement>("#subscribe-msg");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    msg?.classList.remove("hidden");
  });
</script>
