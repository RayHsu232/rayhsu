---
import { Icon } from "astro-icon/components";
import { formatDateCN } from "@utils/posts";
import type { Post } from "@lib/content";

type Props = { post: Post };

const { post } = Astro.props;
const postUrl = `/posts/${post.id}/`;
---

<article
  class="mb-3 rounded-xl border border-hairline bg-elevated px-6 py-5 transition-colors duration-200 hover:border-line max-md:mb-2 max-md:rounded-lg max-md:p-4"
>
  <h2
    class="mb-1.5 text-[1.2rem] leading-snug font-semibold max-md:text-[1.05rem]"
  >
    <a
      href={postUrl}
      class="text-ink transition-colors duration-200 hover:text-brand"
      >{post.data.title}</a
    >
  </h2>
  <p class="mb-2 line-clamp-2 text-sm text-subtle max-md:text-[0.8125rem]">
    {post.data.description}
  </p>
  <div
    class="flex flex-wrap items-center gap-2 text-[0.8125rem] text-faint max-md:text-xs"
  >
    <time datetime={post.data.date.toISOString()}
      >{formatDateCN(post.data.date)}</time
    >
    {
      post.data.category && (
        <span class="inline-flex items-center gap-1">
          <Icon name="ph:folder-open" class="size-3.5 shrink-0" />
          <a
            href={`/category/${post.data.category}/`}
            class="rounded-full bg-chip px-2 py-px text-[0.7rem] text-chip-ink transition-opacity duration-200 hover:opacity-80"
          >
            {post.data.category}
          </a>
        </span>
      )
    }
    {
      post.data.tags.length > 0 && (
        <span class="inline-flex items-center gap-1">
          <Icon name="ph:tag" class="size-3.5 shrink-0" />
          {post.data.tags.map((tag) => (
            <a
              href={`/tag/${tag}/`}
              class="rounded-full bg-chip px-2 py-px text-[0.7rem] text-chip-ink transition-opacity duration-200 hover:opacity-80"
            >
              {tag}
            </a>
          ))}
        </span>
      )
    }
  </div>
</article>
