---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { SITE_CONFIG } from "@config";

const { siteLogo, navLinks, brandName, brandSubtitle, socialLinks } = SITE_CONFIG;
const github = socialLinks.find((l) => l.text === "GitHub");
---

<header class="fixed top-0 left-0 right-0 z-50 h-14 border-b border-hairline bg-base/85 backdrop-blur-md">
  <div class="mx-auto flex h-full max-w-7xl items-center gap-2 px-6">
    <a href="/" class="flex shrink-0 items-center gap-2 text-ink" aria-label="返回首页">
      <Image src={siteLogo} width="28" height="28" class="rounded-md" alt="logo" />
      <span class="flex flex-col leading-tight">
        <span class="text-[1.1rem] font-bold tracking-wide">{brandName}</span>
        <span class="text-xs font-normal opacity-55">{brandSubtitle}</span>
      </span>
    </a>

    <button
      type="button"
      id="navbar-toggle"
      class="ml-auto hidden flex-col gap-1 p-2 max-md:flex"
      aria-expanded="false"
      aria-controls="navbar-links"
      aria-label="切换导航"
    >
      <span class="block h-0.5 w-5 rounded bg-ink"></span>
      <span class="block h-0.5 w-5 rounded bg-ink"></span>
      <span class="block h-0.5 w-5 rounded bg-ink"></span>
    </button>

    <nav
      id="navbar-links"
      class="ml-auto hidden items-center gap-1 max-md:absolute max-md:top-14 max-md:left-0 max-md:right-0 max-md:flex-col max-md:border-b max-md:border-line max-md:bg-base max-md:p-2 md:flex"
    >
      {
        navLinks.map((link) => (
          <a class="rounded-md px-3 py-1.5 text-sm text-subtle transition-colors duration-200 hover:bg-elevated hover:text-ink" href={link.href}>
            {link.text}
          </a>
        ))
      }
      {
        github && (
          <a
            class="inline-flex items-center rounded-md px-2 py-1.5 text-subtle transition-colors duration-200 hover:bg-elevated hover:text-ink"
            href={github.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
          >
            <Icon name="simple-icons:github" class="block size-5" />
          </a>
        )
      }
      <button type="button" id="search-btn" class="inline-flex items-center gap-1 rounded-md px-2 py-1.5 text-subtle transition-colors duration-200 hover:bg-elevated hover:text-ink" aria-label="搜索">
        <Icon name="ph:magnifying-glass" class="block size-5" />
        <span class="hidden items-center gap-0.5 text-xs text-faint lg:inline-flex">
          搜索 <kbd class="rounded border border-line bg-elevated px-1.5 py-px font-mono text-[0.7rem]">Ctrl</kbd>
          <kbd class="rounded border border-line bg-elevated px-1.5 py-px font-mono text-[0.7rem]">K</kbd>
        </span>
      </button>
      <button type="button" id="theme-toggle" class="inline-flex items-center rounded-md px-2 py-1.5 text-subtle transition-colors duration-200 hover:bg-elevated hover:text-ink" aria-label="切换主题">
        <Icon name="ph:sun" class="icon-sun size-5" />
        <Icon name="ph:moon" class="icon-moon size-5" />
      </button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("#navbar-toggle");
  const links = document.querySelector("#navbar-links");
  toggle?.addEventListener("click", () => {
    const isOpen = links?.classList.toggle("max-md:flex") ?? false;
    toggle?.setAttribute("aria-expanded", String(isOpen));
  });
  links?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      links?.classList.remove("max-md:flex");
      toggle?.setAttribute("aria-expanded", "false");
    }),
  );

  const themeBtn = document.querySelector("#theme-toggle");
  themeBtn?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
  });

  document.querySelector("#search-btn")?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("open-search"));
  });
</script>
