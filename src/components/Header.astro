---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { HeaderProps } from "@types";

type Props = HeaderProps;

const { siteLogo, navLinks } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === pathname || (href !== "/" && pathname.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-line bg-base/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" aria-label="返回首页">
      <Image
        class="rounded-full"
        src={siteLogo}
        width="40"
        height="40"
        alt="网站 Logo"
      />
    </a>

    <button
      type="button"
      id="menu-button"
      class="text-subtle sm:hidden"
      aria-expanded="false"
      aria-controls="main-menu"
      aria-label="切换菜单"
    >
      <Icon name="ph:list" class="size-6" />
    </button>

    <nav
      class="absolute top-16 right-5 hidden rounded-2xl border border-line bg-base px-4 py-4 sm:static sm:block sm:border-0 sm:bg-transparent sm:p-0"
      id="main-menu"
    >
      <ul class="flex flex-col gap-1 sm:flex-row sm:gap-2">
        {
          navLinks.map((link) => (
            <li>
              <a
                class:list={[
                  "block rounded-full px-3 py-2 text-sm font-medium transition-colors hover:text-ink",
                  isActive(link.href) ? "text-ink" : "text-subtle",
                ]}
                aria-current={isActive(link.href) ? "page" : undefined}
                href={link.href}
              >
                {link.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector("#menu-button");
  const menu = document.querySelector("#main-menu");

  const toggleMenu = () => {
    menu?.classList.toggle("hidden");
    const isHidden = menu?.classList.contains("hidden");
    button?.setAttribute("aria-expanded", `${!isHidden}`);
  };

  button?.addEventListener("click", toggleMenu);
  menu
    ?.querySelectorAll("a")
    .forEach((item) => item.addEventListener("click", toggleMenu));
</script>
