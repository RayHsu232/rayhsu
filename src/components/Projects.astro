---
import Section from "./Section.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="项目经历" href="projects">
  {
    projects.map(({ name, summary, image, linkPreview, linkSource }) => (
      <div class="mb-6 overflow-hidden rounded-2xl border border-line bg-surface">
        <div class="grid grid-rows-2 sm:grid-cols-2 sm:grid-rows-1">
          <div class="p-6">
            <h3 class="mb-4 text-xl font-semibold text-accent">{name}</h3>
            <p class="mb-8 text-sm leading-relaxed text-muted">{summary}</p>
            <div class="flex gap-5 text-sm font-medium">
              <a
                href={linkSource}
                target="_blank"
                class="inline-flex items-center gap-1 text-accent hover:underline"
              >
                <Icon name="ph:code" class="size-4" />
                Source
              </a>
              <a
                href={linkPreview}
                target="_blank"
                class="inline-flex items-center gap-1 text-accent hover:underline"
              >
                <Icon name="ph:arrow-up-right" class="size-4" />
                Preview
              </a>
            </div>
          </div>
          <div class="flex items-end justify-end overflow-hidden">
            <Image
              class="h-full w-[95%] rounded-ss-xl object-none object-left-top sm:h-[85%] sm:w-full"
              src={image}
              alt={name}
              width="736"
              height="483"
            />
          </div>
        </div>
      </div>
    ))
  }
</Section>
