---
type Heading = { depth: number; slug: string; text: string };
type Props = { headings: Heading[] };

const { headings } = Astro.props;
const tree: { heading: Heading; children: Heading[] }[] = [];
for (const heading of headings) {
  if (heading.depth <= 2) tree.push({ heading, children: [] });
  else tree[tree.length - 1]?.children.push(heading);
}
---

{
  headings.length > 0 && (
    <aside id="toc" class="scroller hidden text-[0.8125rem] min-[1201px]:block" aria-label="目录">
      <div class="border-l border-hairline pl-4">
        <h4 class="mb-2 text-[0.8125rem] font-semibold text-subtle">此页内容</h4>
        <nav id="toc-nav">
          <ul class="m-0 list-none p-0">
            {tree.map(({ heading, children }) => (
              <li class="mb-0.5">
                <a
                  href={`#${heading.slug}`}
                  class="toc-link block rounded px-2 py-0.5 leading-snug text-faint transition-colors duration-200 hover:text-ink"
                  data-slug={heading.slug}
                >
                  {heading.text}
                </a>
                {children.length > 0 && (
                  <ul class="list-none pl-3">
                    {children.map((child) => (
                      <li class="mb-0.5">
                        <a
                          href={`#${child.slug}`}
                          class="toc-link block rounded px-2 py-0.5 leading-snug text-faint transition-colors duration-200 hover:text-ink"
                          data-slug={child.slug}
                        >
                          {child.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </aside>
  )
}

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc-link"));
  const setActive = (slug: string | undefined) => {
    links.forEach((a) => {
      a.classList.toggle("is-active", a.dataset.slug === slug);
      a.classList.toggle("text-brand", a.dataset.slug === slug);
      a.classList.toggle("font-medium", a.dataset.slug === slug);
    });
  };
  if (links.length > 0) {
    setActive(links[0]!.dataset.slug);
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).map((e) => e.target.id);
        if (visible.length > 0) setActive(visible[visible.length - 1]);
      },
      { rootMargin: "-96px 0px -66% 0px", threshold: 0 },
    );
    document.querySelectorAll("h2[id], h3[id]").forEach((h) => observer.observe(h));
  }
</script>
