---
import Section from "./Section.astro";
import { Icon } from "astro-icon/components";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section text="工作经历" href="experience">
  {
    experience.map(({ company, position, startDate, endDate, summary }) => (
      <div class="mb-6 rounded-2xl border border-line bg-elevated p-6">
        <h3 class="mb-1 text-xl font-semibold text-ink">{company}</h3>
        <div class="mb-4 flex flex-col items-start">
          <h4 class="text-lg font-medium text-brand">{position}</h4>
          <span class="text-sm text-subtle">
            {startDate} — {endDate}
          </span>
        </div>
        {Array.isArray(summary) ? (
          <ul class="flex flex-col gap-2">
            {summary.map((log) => (
              <li class="flex items-start gap-2 text-sm leading-relaxed text-subtle">
                <Icon name="ph:check-circle" class="mt-0.5 size-4 shrink-0 text-brand" />
                <span>{log}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm leading-relaxed text-subtle">{summary}</p>
        )}
      </div>
    ))
  }
</Section>
